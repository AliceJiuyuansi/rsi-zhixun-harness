# Build context: only what the runtime needs. The raw XJTU-SY dataset is ~16 GB
# and is NOT needed - the 36-feature cache under data/processed is (1.3 MB).
*
!requirements.txt
!src/
!src/**
!configs/
!configs/**
!scripts/entrypoint.py
!data/processed/xjtu/
!data/processed/xjtu/**
!data/VERSION.md

# no caches, no logs, no experiment output, no credentials
**/__pycache__/
**/*.py[cod]
experiments/
swanlog/
.swanlab/
.env
*.key

# harness image
!harness/
!harness/**
!vendor/
!vendor/**
!_sdk/contest-harness-sdk-1.0.4/
!_sdk/contest-harness-sdk-1.0.4/**

